<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SCRoot" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/scroot_background</item>
        <item name="android:navigationBarColor">@color/scroot_surface</item>
        <item name="android:statusBarColor">@color/scroot_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/scroot_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
